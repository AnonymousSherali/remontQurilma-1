#: templates/masters/for_masters.html:27
msgid "Adolatli nizolar"
msgstr "Честные споры"

#: templates/masters/for_masters.html:27
msgid ""
"Hamma narsa yozma: narx, bosqichlar, yozishma, rasmlar. Nizoda administrator"
