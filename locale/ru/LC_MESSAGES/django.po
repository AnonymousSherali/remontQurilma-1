msgid "Tuman"
msgstr "Район"

msgid "Tumanni tanlang"
msgstr "Выберите район"

msgid "Joylashuvni aniqlay olmasangiz, tumanni tanlang."
msgstr "Если не удаётся определить местоположение, выберите район."

msgid ""
"Masalan: 8 yillik tajriba, Bosch va Samsung servis markazida ishlaganman..."
msgstr "Например: опыт 8 лет, работал в сервисном центре Bosch и Samsung..."

msgid "Masalan: Chilonzor, 9-kvartal"
msgstr "Например: Чиланзар, 9-й квартал"

msgid "Ism familiya"
msgstr "Имя и фамилия"

msgid "Yo'nalishlar"
msgstr "Направления"

msgid "Tajriba (yil)"
msgstr "Опыт (лет)"

msgid "O'zingiz haqingizda"
msgstr "О себе"

msgid "Rasm"
msgstr "Фото"

msgid "Hudud"
msgstr "Район работы"

msgid "Xizmat radiusi (km)"
msgstr "Радиус выезда (км)"

msgid ""
"Saytda ko'rinadi. Aniq uy manzilini yozmang — tuman yoki mahalla yetarli."
msgstr ""
"Видно на сайте. Не указывайте точный домашний адрес — достаточно района или "
"махалли."

msgid "Qancha uzoqlikdagi buyurtmalarga borasiz"
msgstr "На какое расстояние вы готовы выезжать"

msgid "Ism familiyangizni kiriting"
msgstr "Введите имя и фамилию"

msgid "Kamida bitta yo'nalishni tanlang"
msgstr "Выберите хотя бы одно направление"

#, python-format
msgid "Rasm hajmi %(mb)s MB dan oshmasligi kerak"
msgstr "Размер фото не должен превышать %(mb)s МБ"

msgid ""
"Joylashuvingizni aniqlang (\"Joylashuvimni aniqlash\" tugmasi) yoki tumanni "
"tanlang"
msgstr ""
"Определите местоположение (кнопка «Определить моё местоположение») или "
"выберите район"

msgid "Joylashuv O'zbekiston hududidan tashqarida. Qaytadan aniqlang."
msgstr "Местоположение за пределами Узбекистана. Определите заново."

msgid "Telefon raqam"
msgstr "Номер телефона"

msgid "Parol"
msgstr "Пароль"

msgid "Parolni takrorlang"
msgstr "Повторите пароль"

msgid ""
"Shaxsiy ma'lumotlarim qayta ishlanishiga va saytda e'lon qilinishiga roziman"
msgstr "Согласен на обработку персональных данных и их публикацию на сайте"

msgid "Davom etish uchun rozilik bering"
msgstr "Чтобы продолжить, дайте согласие"

msgid "Telefon raqamni SMS kod bilan tasdiqlang"
msgstr "Подтвердите номер телефона кодом из SMS"

msgid ""
"Bu raqam bilan allaqachon ro'yxatdan o'tilgan. Kirish sahifasidan "
"foydalaning."
msgstr "Этот номер уже зарегистрирован. Воспользуйтесь страницей входа."

msgid "Parollar mos kelmadi"
msgstr "Пароли не совпадают"

msgid "Telefon raqam yoki parol noto'g'ri."
msgstr "Неверный номер телефона или пароль."

msgid "Bu akkaunt bloklangan."
msgstr "Этот аккаунт заблокирован."

msgid "Usta haqida fikringiz (ixtiyoriy)"
msgstr "Ваш отзыв о мастере (необязательно)"

msgid "Ismingiz"
msgstr "Ваше имя"

msgid "Izoh"
msgstr "Комментарий"

msgid "Ish sifati"
msgstr "Качество работы"

msgid "O'z vaqtida kelishi"
msgstr "Пунктуальность"

msgid "Narx adolatliligi"
msgstr "Справедливость цены"

msgid "Muomala madaniyati"
msgstr "Вежливость"

msgid "Baho qo'ying"
msgstr "Поставьте оценку"

msgid "Ish narxi (so'm)"
msgstr "Стоимость работы (сум)"

msgid "To'lov tartibi"
msgstr "Порядок оплаты"

msgid "Narxga nima kiradi"
msgstr "Что входит в цену"

msgid "Masalan: nasos almashtirish, ehtiyot qism narxi bilan"
msgstr "Например: замена насоса, с учётом стоимости запчасти"

msgid "Yangi parol"
msgstr "Новый пароль"

msgid "Bu raqam bilan ro'yxatdan o'tilmagan"
msgstr "Этот номер не зарегистрирован"

#, python-format
msgid "%(n)s yulduz"
msgid_plural "%(n)s yulduz"
msgstr[0] "%(n)s звезда"
msgstr[1] "%(n)s звезды"
msgstr[2] "%(n)s звёзд"

msgid "Joriy joylashuvingiz"
msgstr "Ваше текущее местоположение"

msgid ""
"Ro'yxatdan o'tdingiz! Profilingiz administrator tekshiruvidan so'ng saytda "
"ko'rinadi."
msgstr ""
"Вы зарегистрированы! Профиль появится на сайте после проверки "
"администратором."

msgid "Parol yangilandi."
msgstr "Пароль обновлён."

msgid "Kabinetdan foydalanish uchun usta sifatida ro'yxatdan o'ting."
msgstr "Чтобы пользоваться кабинетом, зарегистрируйтесь как мастер."

msgid "Yangi"
msgstr "Новые"

msgid "Jarayonda"
msgstr "В работе"

msgid "Bajarilgan"
msgstr "Выполненные"

msgid "Bekor / nizo"
msgstr "Отменённые / споры"

msgid "Profil saqlandi."
msgstr "Профиль сохранён."

msgid "Endi siz buyurtma qabul qilasiz."
msgstr "Теперь вы принимаете заказы."

msgid "Siz qidiruvdan vaqtincha yashirildingiz. Yangi buyurtmalar kelmaydi."
msgstr "Вы временно скрыты из поиска. Новые заказы не поступят."

msgid ""
"Ish bajarildi deb belgilandi. Mijoz natijani tasdiqlashi va baholashi kerak."
msgstr ""
"Работа отмечена как выполненная. Клиент должен подтвердить результат и "
"оставить оценку."

#, python-format
msgid "Buyurtma #%(id)s: %(status)s"
msgstr "Заказ #%(id)s: %(status)s"

msgid "Narx taklifi mijozga yuborildi."
msgstr "Предложение цены отправлено клиенту."

#, python-format
msgid "Kodni qayta yuborish uchun %(sec)s soniya kuting"
msgstr "Повторная отправка кода возможна через %(sec)s с"

msgid "Bu raqamga juda ko'p kod yuborildi. Bir soatdan keyin urinib ko'ring."
msgstr "На этот номер отправлено слишком много кодов. Попробуйте через час."

msgid "Juda ko'p so'rov. Keyinroq urinib ko'ring."
msgstr "Слишком много запросов. Попробуйте позже."

#, python-format
msgid "%(site)s: tasdiqlash kodi %(code)s. Hech kimga aytmang."
msgstr "%(site)s: код подтверждения %(code)s. Никому не сообщайте."

msgid "Kod muddati o'tgan yoki yuborilmagan. Yangi kod oling."
msgstr "Срок действия кода истёк или код не отправлялся. Запросите новый."

msgid "Urinishlar soni tugadi. Yangi kod oling."
msgstr "Попытки исчерпаны. Запросите новый код."

#, python-format
msgid "Kod noto'g'ri. Qolgan urinishlar: %(n)s"
msgstr "Неверный код. Осталось попыток: %(n)s"

msgid "Mijoz javobini kutmoqda"
msgstr "Ожидает ответа клиента"

msgid "Kelishilgan"
msgstr "Согласовано"

msgid "Rad etilgan"
msgstr "Отклонено"

msgid "To'lanmagan"
msgstr "Не оплачено"

msgid "Ushlab turilibdi"
msgstr "Удерживается"

msgid "Ustaga chiqarildi"
msgstr "Выплачено мастеру"

msgid "Qaytarildi"
msgstr "Возвращено"

msgid "To'liq summa — tasdiqlangandan keyin"
msgstr "Полная сумма — после подтверждения"

msgid "Avans (materiallar uchun) — ish boshlanganda"
msgstr "Аванс (на материалы) — при начале работ"

msgid "Qolgan qism — tasdiqlangandan keyin"
msgstr "Остаток — после подтверждения"

msgid "1-qism — ish boshlanganda"
msgstr "1-я часть — при начале работ"

msgid "2-qism — ish bajarilganda"
msgstr "2-я часть — после выполнения"

msgid "3-qism — tasdiqlangandan keyin"
msgstr "3-я часть — после подтверждения"

msgid "Ish yakunida to'liq (pul oldindan platformada ushlab turiladi)"
msgstr "Полностью по завершении (деньги заранее удерживаются на платформе)"

msgid "30% avans + 70% yakunda"
msgstr "Аванс 30% + 70% по завершении"

msgid "3 teng qism: boshlanganda / bajarilganda / tasdiqlanganda"
msgstr "3 равные части: при начале / после выполнения / после подтверждения"

msgid "Naqd yoki to'g'ridan-to'g'ri ustaga (platforma kafolatisiz)"
msgstr "Наличными или напрямую мастеру (без гарантии платформы)"

msgid "Narxni hozir o'zgartirib bo'lmaydi"
msgstr "Сейчас цену изменить нельзя"

msgid "Summa musbat bo'lishi kerak"
msgstr "Сумма должна быть положительной"

msgid "Bu taklif allaqachon ko'rib chiqilgan"
msgstr "Это предложение уже рассмотрено"

msgid "Bu bosqich mablag'ini hozir chiqarib bo'lmaydi"
msgstr "Сейчас нельзя выплатить средства этого этапа"

msgid "Faqat ushlab turilgan mablag' qaytariladi"
msgstr "Вернуть можно только удерживаемые средства"

msgid ""
"To'lov qabul qilindi. Mablag' bosqich bajarilguncha platformada ushlab "
"turiladi."
msgstr "Оплата принята. Деньги удерживаются на платформе до выполнения этапа."

msgid "Qayta yuborish"
msgstr "Отправить повторно"

msgid "Sinov rejimi, kod:"
msgstr "Тестовый режим, код:"

msgid "Tarmoq xatosi. Qaytadan urinib ko'ring."
msgstr "Ошибка сети. Попробуйте ещё раз."

msgid "Formadagi xatolarni to'g'rilang"
msgstr "Исправьте ошибки в форме"

msgid "Xatolik yuz berdi. Keyinroq urinib ko'ring."
msgstr "Произошла ошибка. Попробуйте позже."

msgid "Havola nusxalandi"
msgstr "Ссылка скопирована"

msgid "Aniqlanmoqda…"
msgstr "Определяем…"

msgid "✓ Joylashuv aniqlandi"
msgstr "✓ Местоположение определено"

msgid "Brauzeringiz joylashuvni aniqlay olmaydi. Tumanni tanlang."
msgstr "Браузер не умеет определять местоположение. Выберите район."

msgid "Joylashuv faqat HTTPS orqali ishlaydi. Hozircha tumanni tanlang."
msgstr "Геолокация работает только по HTTPS. Пока выберите район."

msgid ""
"Joylashuvga ruxsat berilmadi. Brauzer sozlamalaridan ruxsat bering yoki "
"tumanni tanlang."
msgstr ""
"Доступ к местоположению запрещён. Разрешите его в настройках браузера или "
"выберите район."

msgid "Joylashuvni aniqlab bo'lmadi. Tumanni tanlang."
msgstr "Не удалось определить местоположение. Выберите район."

msgid "✓ Joylashuv xaritada belgilandi"
msgstr "✓ Местоположение отмечено на карте"

msgid "baho"
msgstr "оценок"

msgid "Profilni ochish →"
msgstr "Открыть профиль →"

msgid "Siz"
msgstr "Вы"

msgid "Buyurtmani ochish"
msgstr "Открыть заказ"

#, python-format
msgid "Buyurtmangiz #%(id)s qabul qilindi. Holatini kuzating: %(url)s"
msgstr "Ваш заказ #%(id)s принят. Следите за статусом: %(url)s"

#, python-format
msgid "Yangi buyurtma #%(id)s: %(name)s. Kabinet: %(url)s"
msgstr "Новый заказ #%(id)s: %(name)s. Кабинет: %(url)s"

#, python-format
msgid "Usta %(master)s buyurtmangizni qabul qildi. Tel: %(phone)s. %(url)s"
msgstr "Мастер %(master)s принял ваш заказ. Тел.: %(phone)s. %(url)s"

#, python-format
msgid "Usta %(master)s yetib keldi. %(url)s"
msgstr "Мастер %(master)s на месте. %(url)s"

#, python-format
msgid "Usta ishni yakunladi. Natijani tasdiqlang va baholang: %(url)s"
msgstr "Мастер завершил работу. Подтвердите результат и оцените: %(url)s"

#, python-format
msgid "Usta buyurtmani bekor qildi. Boshqa usta topamiz: %(url)s"
msgstr "Мастер отменил заказ. Мы подберём другого: %(url)s"

#, python-format
msgid "Mijoz #%(id)s buyurtmani tasdiqladi."
msgstr "Клиент подтвердил заказ #%(id)s."

#, python-format
msgid "Mijoz #%(id)s buyurtmani bekor qildi."
msgstr "Клиент отменил заказ #%(id)s."

#, python-format
msgid "Mijoz #%(id)s buyurtma bo'yicha nizo ochdi. Administrator bog'lanadi."
msgstr "Клиент открыл спор по заказу #%(id)s. С вами свяжется администратор."

#, python-format
msgid "Usta narx taklif qildi: %(amount)s so'm. Ko'rib chiqing: %(url)s"
msgstr "Мастер предложил цену: %(amount)s сум. Посмотрите: %(url)s"

msgid "Shaxsiy ma'lumotlarni qayta ishlashga rozilik bering"
msgstr "Дайте согласие на обработку персональных данных"

msgid "Ismingizni kiriting"
msgstr "Введите ваше имя"

msgid "Telefon raqamni kiriting"
msgstr "Введите номер телефона"

msgid "Bu usta hozir buyurtma qabul qilmaydi"
msgstr "Этот мастер сейчас не принимает заказы"

msgid "Ism kamida 2 ta belgidan iborat bo'lishi kerak"
msgstr "Имя должно содержать не менее 2 символов"

msgid "Spam aniqlandi"
msgstr "Обнаружен спам"

msgid "Bu usta hozir buyurtma qabul qilmayapti. Boshqa ustani tanlang."
msgstr "Этот мастер сейчас не принимает заказы. Выберите другого мастера."

msgid "Yaratildi"
msgstr "Создан"

msgid "Qabul qilindi"
msgstr "Принят"

msgid "Joyida"
msgstr "На месте"

msgid "Ishda"
msgstr "В работе"

msgid "Bajarildi"
msgstr "Выполнен"

msgid "Tasdiqlandi"
msgstr "Подтверждён"

msgid "Bekor qilindi"
msgstr "Отменён"

msgid "Nizo"
msgstr "Спор"

msgid "Buyurtmachi"
msgstr "Заказчик"

msgid "Usta"
msgstr "Мастер"

msgid "Administrator"
msgstr "Администратор"

msgid "Tizim"
msgstr "Система"

msgid "Avval telefon raqamingizni SMS kod bilan tasdiqlang."
msgstr "Сначала подтвердите номер телефона кодом из SMS."

msgid "Buyurtma holati yangilandi."
msgstr "Статус заказа обновлён."

msgid ""
"Narx kelishildi. Endi birinchi qismni to'lang — pul ustaga darhol o'tmaydi, "
"bosqich bajarilguncha platformada ushlab turiladi."
msgstr ""
"Цена согласована. Оплатите первую часть — деньги не уходят мастеру сразу, а "
"удерживаются на платформе до выполнения этапа."

msgid "Narx kelishildi. To'lovni ustaga to'g'ridan-to'g'ri qilasiz."
msgstr "Цена согласована. Оплату вы производите мастеру напрямую."

msgid "Taklif rad etildi. Usta yangi narx taklif qilishi mumkin."
msgstr "Предложение отклонено. Мастер может предложить новую цену."

msgid "Taklif topilmadi"
msgstr "Предложение не найдено"

#, python-format
msgid "To'lov chiqarildi: %(t)s"
msgstr "Оплата выплачена: %(t)s"

msgid "Mablag' ustaga chiqarildi. Rahmat!"
msgstr "Средства выплачены мастеру. Спасибо!"

msgid "Telefon raqamini to'g'ri kiriting: +998 (XX) XXX-XX-XX"
msgstr "Введите номер в формате: +998 (XX) XXX-XX-XX"

msgid ""
"Juda ko'p ariza yuborildi. Iltimos, birozdan keyin urinib ko'ring yoki "
"qo'ng'iroq qiling."
msgstr "Слишком много заявок. Попробуйте чуть позже или позвоните нам."

#, python-format
msgid "Arizangiz %(master)sga yuborildi. Usta tez orada qo'ng'iroq qiladi."
msgstr "Заявка отправлена мастеру %(master)s. Он скоро перезвонит."

msgid ""
"Arizangiz qabul qilindi! Operatorimiz eng yaqin ustani topib, siz bilan "
"bog'lanadi."
msgstr ""
"Заявка принята! Оператор подберёт ближайшего мастера и свяжется с вами."

msgid "Arizangiz uchun rahmat!"
msgstr "Спасибо за заявку!"

msgid "Buyurtma yaratildi"
msgstr "Заказ создан"

msgid "Vazifa, manzil va qulay vaqtni tasvirlaysiz."
msgstr "Вы описываете задачу, адрес и удобное время."

msgid "Usta ishni olishini tasdiqlaydi."
msgstr "Мастер подтверждает, что берёт работу."

msgid "Usta kelganini belgilaydi — buni buyurtmada darhol ko'rasiz."
msgstr "Мастер отмечает, что прибыл — вы сразу видите это в заказе."

msgid "Ish haqiqatan boshlanganda status o'zgaradi."
msgstr "Статус меняется, когда работа действительно началась."

msgid "Usta o'z tomonidan buyurtmani yopadi."
msgstr "Мастер закрывает заказ со своей стороны."

msgid "Siz natijani tekshirasiz, tasdiqlaysiz va baholaysiz."
msgstr "Вы проверяете результат, подтверждаете и оцениваете."

msgid "Qabul qilish"
msgstr "Принять"

msgid "Joyga yetib keldim"
msgstr "Я на месте"

msgid "Ishni boshladim"
msgstr "Начал работу"

msgid "Ish bajarildi"
msgstr "Работа выполнена"

msgid "Bekor qilish"
msgstr "Отменить"

msgid "Natijani tasdiqlash"
msgstr "Подтвердить результат"

msgid "Buyurtmani bekor qilish"
msgstr "Отменить заказ"

msgid "Muammo bor (nizo ochish)"
msgstr "Есть проблема (открыть спор)"

msgid "Noma'lum amal"
msgstr "Неизвестное действие"

msgid "Bu amalni hozirgi bosqichda bajarib bo'lmaydi"
msgstr "Это действие недоступно на текущем этапе"

msgid "Buyurtmaga usta biriktirilmagan"
msgstr "К заказу не назначен мастер"

msgid "Ishni boshlashdan oldin narxni taklif qiling va mijoz rozi bo'lsin"
msgstr "Перед началом работ предложите цену и получите согласие клиента"

#, python-format
msgid "Avval to'lang: %(names)s"
msgstr "Сначала оплатите: %(names)s"

#, python-format
msgid "Mijoz hali to'lamagan: %(names)s. To'lovdan keyin davom eting."
msgstr "Клиент ещё не оплатил: %(names)s. Продолжите после оплаты."

#, python-format
msgid "Avtomatik: mijoz %(h)s soat ichida javob bermadi"
msgstr "Автоматически: клиент не ответил в течение %(h)s ч"

msgid "Saytda ochish"
msgstr "Открыть на сайте"

msgid "Havola noto'g'ri yoki eskirgan."
msgstr "Ссылка неверна или устарела."

msgid "Buyurtma topilmadi."
msgstr "Заказ не найден."

#, python-format
msgid ""
"✅ Buyurtma #%(id)s ulandi. Endi barcha o'zgarishlar shu yerga keladi.\n"
"\n"
"Hozirgi holat: <b>%(status)s</b>"
msgstr ""
"✅ Заказ #%(id)s подключён. Теперь все изменения будут приходить сюда.\n"
"\n"
"Текущий статус: <b>%(status)s</b>"

msgid ""
"Ulash havolasi eskirgan. Kabinetdan qaytadan «Telegram'ni ulash» ni bosing."
msgstr ""
"Ссылка для подключения устарела. Нажмите «Подключить Telegram» в кабинете "
"ещё раз."

msgid "Bu chat boshqa akkauntga ulangan."
msgstr "Этот чат подключён к другому аккаунту."

#, python-format
msgid ""
"✅ Salom, %(name)s! Akkauntingiz ulandi. Yangi buyurtmalar shu yerga tugmalar bilan keladi.\n"
"\n"
"/buyurtmalar — faol buyurtmalar\n"
"/stop — o'chirish"
msgstr ""
"✅ Здравствуйте, %(name)s! Аккаунт подключён. Новые заказы будут приходить сюда с кнопками.\n"
"\n"
"/buyurtmalar — активные заказы\n"
"/stop — отключить"

#, python-format
msgid ""
"Assalomu alaykum! Bu %(site)s boti.\n"
"\n"
"• Buyurtmachilar: buyurtma sahifasidagi «Telegram'da kuzatish» tugmasini bosing.\n"
"• Ustalar: kabinetda «Telegram'ni ulash» tugmasini bosing."
msgstr ""
