# TechService - Muhit sozlamalari namunasi
# Ushbu faylni .env nomiga nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env

# Django maxfiy kaliti (ALBATTA o'zgartiring)
DJANGO_SECRET_KEY=django-insecure-o-zgingizning-maxfiy-kalitingizni-bu-yerga-yozing

# Debug rejim (production uchun False qiling)
DJANGO_DEBUG=True

# Ruxsat etilgan hostlar (vergul bilan ajrating)
# Namuna: DJANGO_ALLOWED_HOSTS=techservice.uz,www.techservice.uz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF ishonchli manbaalar (production uchun)
# Namuna: DJANGO_CSRF_TRUSTED_ORIGINS=https://techservice.uz
DJANGO_CSRF_TRUSTED_ORIGINS=
