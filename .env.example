# TechService — muhit sozlamalari namunasi.
# Nusxa oling:  cp .env.example .env   (Windows: copy .env.example .env)

# --- Xavfsizlik ---
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DJANGO_CSRF_TRUSTED_ORIGINS=https://techservice.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Sayt kontaktlari (saytning barcha joyida ko'rinadi) ---
# DIQQAT: standart qiymatlar namunaviy — o'zingiznikini yozing!
SITE_NAME=TechService
SITE_PHONE=+998901234567
SITE_EMAIL=info@techservice.uz
SITE_ADDRESS=Toshkent shahar
SITE_TELEGRAM=
SITE_HOURS=Har kuni 08:00–22:00

# --- Yandex xarita (ixtiyoriy, https://developer.tech.yandex.ru) ---
# Kalitsiz ham xarita odatda ochiladi, lekin tijorat sayti uchun kalit talab qilinadi.
YANDEX_MAPS_API_KEY=

# --- Yangi ariza haqida Telegram xabari (ixtiyoriy) ---
# Bot: @BotFather; chat id: botni guruhga qo'shib, @userinfobot yoki getUpdates orqali
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 10 daqiqada bitta IP'dan qabul qilinadigan arizalar soni (spamdan himoya)
REQUEST_RATE_LIMIT=5

# Saytning to'liq manzili — SMS'dagi havolalar shu bilan boshlanadi
SITE_URL=http://127.0.0.1:8000

# --- SMS (Eskiz.uz) ---
# console — kod server konsoliga chiqadi (ishlab chiqish); eskiz — haqiqiy SMS
SMS_BACKEND=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_SENDER=4546

# --- To'lovlar ---
# Mijozga taklif qilinadigan tizimlar, vergul bilan: demo | payme | click
# demo — sinov sahifasi (faqat DEBUG=True da ishlaydi). Masalan: PAYMENT_PROVIDERS=payme,click,uzum
PAYMENT_PROVIDERS=demo
PLATFORM_FEE_PERCENT=10
AUTO_CONFIRM_HOURS=72
AUTO_RELEASE_HOURS=48
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=True
PAYME_ACCOUNT_KEY=milestone_id

# Click (Click kabinetidan). Prepare/Complete URL: SITE_URL/payments/click/prepare/ va .../complete/
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Uzum Bank (webhook: SITE_URL/payments/uzum/<check|create|confirm|reverse|status>/, Basic auth).
# DIQQAT: integratsiya Uzum rasmiy hujjati bilan solishtirilmagan — README'ga qarang.
UZUM_SERVICE_ID=
UZUM_LOGIN=
UZUM_PASSWORD=
UZUM_ACCOUNT_KEY=account

# --- Ustalar uchun tariflar (namunaviy narxlar, so'm) ---
TARIFF_TOP_7_PRICE=50000
TARIFF_TOP_30_PRICE=150000
TARIFF_PRO_30_PRICE=200000
PRO_FEE_PERCENT=5

# --- Ochiq buyurtmalar lentasi ---
FEED_PRO_HEAD_START_MINUTES=10
ACTIVE_ORDERS_LIMIT=5
PRO_ACTIVE_ORDERS_LIMIT=10

# --- Kafolat (namunaviy qiymatlar) ---
WARRANTY_DAYS=30
WARRANTY_RESPONSE_HOURS=48
WARRANTY_AUTO_CLOSE_DAYS=7
GUARANTEE_MAX_AMOUNT=1000000

# --- Telegram bot (mijoz va ustalar uchun; yuqoridagi TELEGRAM_BOT_TOKEN bilan bir xil bot) ---
TELEGRAM_BOT_USERNAME=
# Tasodifiy uzun satr; keyin: python manage.py telegram_webhook
TELEGRAM_WEBHOOK_SECRET=

# --- Kelish vaqti va yozishma ---
VISIT_REMINDER_HOURS=2
CHAT_OPEN_DAYS=30
CHAT_SMS_INTERVAL_MINUTES=30

# --- Yuridik ma'lumotlar (oferta va maxfiylik siyosati sahifalari) ---
SITE_LEGAL_NAME=
SITE_LEGAL_INN=
SITE_LEGAL_ADDRESS=
# Yurist matnni tasdiqlagach False qiling — "Loyiha" ogohlantirishi yo'qoladi
LEGAL_DRAFT=True
